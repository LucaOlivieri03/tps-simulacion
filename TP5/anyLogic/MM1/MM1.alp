		<!--   =========  Parameter Variation Experiment   ========  -->
		<ParamVariationExperiment ActiveObjectClassId="1534180659931">
			<Id>1782434569378</Id>
			<Name><![CDATA[ExpSensibilidad]]></Name>
			<CommandLineArguments><![CDATA[]]></CommandLineArguments>
			<MaximumMemory>512</MaximumMemory>
			<RandomNumberGenerationType>fixedSeed</RandomNumberGenerationType>
			<CustomGeneratorCode>new Random()</CustomGeneratorCode>
			<AfterSimulationRunCode><![CDATA[// 1. Calculamos el parámetro de interés pi (Eje X)
double pi_rho = root.lam / root.mu;

// 2. Extraemos el estimador C de la utilización
double c_rho = root.resourcePool.utilization();
dsRho.add(pi_rho, c_rho);

// 3. Tiempos Wq y W (Extraídos de tu cronómetro)
double c_Wq = root.tmE_Q.distribution.mean();
dsWq.add(pi_rho, c_Wq);

// El tiempo total (W) es el tiempo en cola + tiempo de servicio
double c_W = c_Wq + (1.0 / root.mu); 
dsW.add(pi_rho, c_W); 

// 4. Longitudes Lq y L (Calculadas mágicamente con la Ley de Little)
// Lq = lambda * Wq
double c_Lq = root.lam * c_Wq;
dsLq.add(pi_rho, c_Lq);

// L = Lq + Utilización (Clientes esperando + cliente atendiéndose)
double c_L = c_Lq + c_rho;
dsL.add(pi_rho, c_L);]]></AfterSimulationRunCode>
			<SeedValue>1</SeedValue>
			<SelectionModeForSimultaneousEvents>LIFO</SelectionModeForSimultaneousEvents>
